{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/(favicon\\.svg|favicon\\.ico|robots\\.txt|.*\\.(?:ico|png|jpg|jpeg|svg|css|js|woff|woff2))",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_KEY": "base64:v6FE2Mb/HSGukpWvLtUvKYUhb5ncDu0NHR67C8HLKvk=",
        "APP_URL": "https://project-kelompok.vercel.app",
        "APP_MAINTENANCE_DRIVER": "file",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "CACHE_STORE": "array",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",
        "SESSION_LIFETIME": "10080",
        "LOG_CHANNEL": "single",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": "/tmp/database_v2.sqlite",
        "BROADCAST_CONNECTION": "log",
        "BROADCAST_DRIVER": "log",
        "FILESYSTEM_DISK": "local",
        "FILESYSTEM_DRIVER": "local",
        "QUEUE_CONNECTION": "sync",
        "MAIL_MAILER": "log"
    }
}